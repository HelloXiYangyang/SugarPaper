<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SugarPaper.MainWindow"
        Title="糖纸 · SugarPaper"
        Icon="/Assets/app_icon.ico"
        Width="1200" Height="760"
        MinWidth="880" MinHeight="560">
    <Grid ColumnDefinitions="200,*,320">
        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#EDEDED" BorderThickness="0,0,1,0">
            <StackPanel Margin="12" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,8,8,16">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#1677FF">
                        <Path Data="M 11,18 L 15,22 L 24,12" Stroke="White" StrokeThickness="3"
                              StrokeLineCap="Round" VerticalAlignment="Center"
                              HorizontalAlignment="Center" Stretch="Fill"/>
                    </Border>
                    <TextBlock Text="糖纸" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="今天" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="日历" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="专注" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="统计" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                <Button Content="我的" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- 中间任务列表 -->
        <Border Grid.Column="1" Background="White" Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="今天" FontSize="22" FontWeight="Bold"/>
                <TextBox Watermark="添加作业…" CornerRadius="20" Height="44"/>
                <Border Background="#F7F7F7" CornerRadius="14" Padding="16,12">
                    <TextBlock Text="今天（4）" FontWeight="SemiBold"/>
                </Border>
                <Border Background="White" BorderBrush="#EBEBEB" BorderThickness="1" CornerRadius="14" Padding="14">
                    <Grid ColumnDefinitions="22,*,Auto">
                        <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#EBEBEB" BorderThickness="2"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                            <TextBlock Text="数学 · 试卷订正" FontSize="15" FontWeight="Medium"/>
                            <TextBlock Text="今天 18:00" FontSize="12" Foreground="#A0A0A0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="右侧选中任务后显示详情" Foreground="#A0A0A0" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- 右侧详情面板 -->
        <Border Grid.Column="2" Background="#F7F7F7" BorderBrush="#EDEDED" BorderThickness="1,0,0,0" Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="详情" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="科目 · 截止 · 优先级 · 备注 · 图片 · 子任务 · 提醒" FontSize="13"
                           Foreground="#6E6E6E" TextWrapping="Wrap"/>
                <TextBlock Text="（未选中任务时显示今日概览 / 统计摘要）" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
